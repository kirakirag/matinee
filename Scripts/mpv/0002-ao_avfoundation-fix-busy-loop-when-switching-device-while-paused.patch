From 5a5d2f5e9d53751b42b65c5d0e38b687acfa3bfb Mon Sep 17 00:00:00 2001
From: der richter <der.richter@gmx.de>
Date: Sun, 8 Nov 2026 13:26:24 +0100
Subject: [PATCH] ao_avfoundation: fix busy loop when switching device while
 paused

when the output device changes we get a handleRestart notification, this
calls stop() followed by start(). in the case of playback being paused,
start() unpauses the synchronizer and starts requesting media data. when
paused we don't get any data, the renderer stays ready for more media
data and feed() is called in a busy loop, using 100% of a core.
furthermore, since the notification runs on a different thread than the
playback thread, we can possibly have race conditions between start,
stop and pausing.

fix this by tracking the paused state, not calling start unconditionally
in the restart handler and properly handle requesting media data in
set_pause. also run start, stop and pause on the same queue as feed, so
calls can not interleave and prevent any race condition.
---
 audio/out/ao_avfoundation.m | 64 +++++++++++++++++++++++++++++--------
 1 file changed, 51 insertions(+), 13 deletions(-)

diff --git a/audio/out/ao_avfoundation.m b/audio/out/ao_avfoundation.m
index 09f3ef0..bebe5dc 100644
--- a/audio/out/ao_avfoundation.m
+++ b/audio/out/ao_avfoundation.m
@@ -44,7 +44,10 @@ - (void)handleRestartNotification:(NSNotification*)notification;
     dispatch_queue_t queue;
     CMAudioFormatDescriptionRef format_description;
     AVObserver *observer;
+
+    // only access on queue
     int64_t end_time_av;
+    bool paused;
 };
 
 static int64_t CMTimeGetNanoseconds(CMTime time)
@@ -140,25 +143,49 @@ static void feed(struct ao *ao)
     if (sample_buffer) CFRelease(sample_buffer);
 }
 
-static void start(struct ao *ao)
+static void request_media_data(struct ao *ao)
 {
     struct priv *p = ao->priv;
 
-    p->end_time_av = -1;
-    [p->synchronizer setRate:1];
     [p->renderer requestMediaDataWhenReadyOnQueue:p->queue usingBlock:^{
         feed(ao);
     }];
 }
 
+static void start_queue(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+
+    p->end_time_av = -1;
+    [p->synchronizer setRate:1];
+    request_media_data(ao);
+}
+
+static void stop_queue(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+
+    [p->renderer stopRequestingMediaData];
+    [p->renderer flush];
+    [p->synchronizer setRate:0];
+}
+
+static void start(struct ao *ao)
+{
+    struct priv *p = ao->priv;
+
+    dispatch_sync(p->queue, ^{
+        p->paused = false;
+        start_queue(ao);
+    });
+}
+
 static void stop(struct ao *ao)
 {
     struct priv *p = ao->priv;
 
     dispatch_sync(p->queue, ^{
-        [p->renderer stopRequestingMediaData];
-        [p->renderer flush];
-        [p->synchronizer setRate:0];
+        stop_queue(ao);
     });
 }
 
@@ -166,11 +193,16 @@ static bool set_pause(struct ao *ao, bool paused)
 {
     struct priv *p = ao->priv;
 
-    if (paused) {
-        [p->synchronizer setRate:0];
-    } else {
-        [p->synchronizer setRate:1];
-    }
+    dispatch_sync(p->queue, ^{
+        p->paused = paused;
+        if (paused) {
+            [p->renderer stopRequestingMediaData];
+            [p->synchronizer setRate:0];
+        } else {
+            [p->synchronizer setRate:1];
+            request_media_data(ao);
+        }
+    });
 
     return true;
 }
@@ -206,12 +238,18 @@ - (instancetype)initWithAO:(struct ao*)_ao {
     return self;
 }
 - (void)handleRestartNotification:(NSNotification*)notification {
+    struct priv *p = ao->priv;
+
     char *name = cfstr_get_cstr((CFStringRef)notification.name);
     MP_WARN(ao, "restarting due to system notification; this will cause desync\n");
     MP_VERBOSE(ao, "notification name: %s\n", name);
     talloc_free(name);
-    stop(ao);
-    start(ao);
+
+    dispatch_sync(p->queue, ^{
+        stop_queue(ao);
+        if (!p->paused)
+            start_queue(ao);
+    });
 }
 @end
 
