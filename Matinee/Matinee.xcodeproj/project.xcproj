{
  "default-configuration": "Release",
  "configurations": [
    "Debug",
    "Release",
  ],
  "localizations": {
    "development": "en",
    "supported": [
      "Base",
    ],
  },
  "packages": [
    {
      "kind": "remote",
      "repository": "https://github.com/ml-explore/mlx-swift-lm",
      "version": {
        "up-to-next-major-version": "3.32.3",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/ml-explore/mlx-swift",
      "version": {
        "up-to-next-minor-version": "0.32.3",
      },
    }, {
      "kind": "remote",
      "repository": "https://github.com/huggingface/swift-transformers",
      "version": {
        "up-to-next-major-version": "1.3.0",
      },
    },
  ],
  "files": [
    { "kind": "folder", "path": "Matinee", "target-membership": [ "Matinee" ] },
    { "kind": "folder", "path": "MatineeKit", "target-membership": [ "MatineeKit" ] },
    { "kind": "folder", "path": "MatineeKitTests", "target-membership": [ "MatineeKitTests" ] },
    { "kind": "folder", "path": "matinee-import", "target-membership": [ "matinee-import" ] },
    {
      "kind": "group",
      "name": "Products",
      "children": [
        { "path": "<PRODUCTS>/Matinee.app", "id": "4FFA4BC13098BE8200C45EB1", "type": "wrapper.application", "index": false },
        { "path": "<PRODUCTS>/MatineeKit.framework", "id": "4FFA4BD33098BE8900C45EB1", "type": "wrapper.framework", "index": false, "target-membership": [ "MatineeKitTests/frameworks", "matinee-import/frameworks" ] },
        { "path": "<PRODUCTS>/MatineeKitTests.xctest", "id": "4FFA4BDB3098BE8900C45EB1", "type": "wrapper.cfbundle", "index": false },
        { "path": "<PRODUCTS>/matinee-import", "id": "4F663BEC3098C1FA00BCE066", "type": "compiled.mach-o.executable", "index": false },
      ],
    },
  ],
  "targets": [
    {
      "name": "Matinee",
      "id": "4FFA4BC03098BE8200C45EB1",
      "product": "Products/Matinee.app",
      "product-type": "application",
      "build-phases": [
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "package-product-members": [
        {
          "package": "mlx-swift",
          "product-name": "MLX",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "mlx-swift-lm",
          "product-name": "MLXEmbedders",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "mlx-swift-lm",
          "product-name": "MLXLLM",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "mlx-swift-lm",
          "product-name": "MLXLMCommon",
          "build-phase": { "build-phase": "frameworks" },
        }, {
          "package": "swift-transformers",
          "product-name": "Tokenizers",
          "build-phase": { "build-phase": "frameworks" },
        },
      ],
      "build-settings": {
        "ASSETCATALOG_COMPILER_APPICON_NAME": "AppIcon",
        "ASSETCATALOG_COMPILER_GLOBAL_ACCENT_COLOR_NAME": "AccentColor",
        "CODE_SIGN_ENTITLEMENTS": "Matinee.entitlements",
        "CODE_SIGN_STYLE": "Automatic",
        "COMBINE_HIDPI_IMAGES": "YES",
        "CURRENT_PROJECT_VERSION": "10",
        "ENABLE_APP_SANDBOX": "YES",
        "ENABLE_FILE_ACCESS_MOVIES_FOLDER": "readwrite",
        "ENABLE_INCOMING_NETWORK_CONNECTIONS": "NO",
        "ENABLE_OUTGOING_NETWORK_CONNECTIONS": "YES",
        "ENABLE_PREVIEWS": "YES",
        "ENABLE_RESOURCE_ACCESS_AUDIO_INPUT": "NO",
        "ENABLE_RESOURCE_ACCESS_BLUETOOTH": "NO",
        "ENABLE_RESOURCE_ACCESS_CALENDARS": "NO",
        "ENABLE_RESOURCE_ACCESS_CAMERA": "NO",
        "ENABLE_RESOURCE_ACCESS_CONTACTS": "NO",
        "ENABLE_RESOURCE_ACCESS_LOCATION": "NO",
        "ENABLE_RESOURCE_ACCESS_PRINTING": "NO",
        "ENABLE_RESOURCE_ACCESS_USB": "NO",
        "ENABLE_USER_SELECTED_FILES": "readonly",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "",
        "LD_RUNPATH_SEARCH_PATHS": [
          "$(inherited)",
          "@executable_path/../Frameworks",
          "@executable_path/../Resources/Mpv.bundle/lib",
        ],
        "MACOSX_DEPLOYMENT_TARGET": "27.0",
        "MARKETING_VERSION": "1.4.2",
        "OTHER_LDFLAGS": [
          "-L$(SRCROOT)/Matinee/Mpv.bundle/lib",
          "-lmpv.2",
        ],
        "PRODUCT_BUNDLE_IDENTIFIER": "local.kirakirag.matinee",
        "PRODUCT_NAME": "$(TARGET_NAME)",
        "REGISTER_APP_GROUPS": "YES",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_DEFAULT_ACTOR_ISOLATION": "MainActor",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_INCLUDE_PATHS": "$(SRCROOT)/CMpv",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "6.0",
      },
    }, {
      "name": "MatineeKit",
      "id": "4FFA4BD23098BE8900C45EB1",
      "product": "Products/MatineeKit.framework",
      "product-type": "framework",
      "build-phases": [
        "headers",
        "compile-sources",
        "frameworks",
        "resources",
      ],
      "build-settings": {
        "ALLOW_TARGET_PLATFORM_SPECIALIZATION": "YES",
        "BUILD_LIBRARY_FOR_DISTRIBUTION": "NO",
        "CODE_SIGN_STYLE": "Automatic",
        "CURRENT_PROJECT_VERSION": "10",
        "DYLIB_COMPATIBILITY_VERSION": "1",
        "DYLIB_CURRENT_VERSION": "1",
        "DYLIB_INSTALL_NAME_BASE": "@rpath",
        "ENABLE_MODULE_VERIFIER": "YES",
        "GENERATE_INFOPLIST_FILE": "YES",
        "INFOPLIST_KEY_NSHumanReadableCopyright": "",
        "INSTALL_PATH": "$(LOCAL_LIBRARY_DIR)/Frameworks",
        "IPHONEOS_DEPLOYMENT_TARGET": "27.2",
        "LD_RUNPATH_SEARCH_PATHS": [
          "@executable_path/Frameworks",
          "@loader_path/Frameworks",
        ],
        "LD_RUNPATH_SEARCH_PATHS[sdk=macosx*]": [
          "@executable_path/../Frameworks",
          "@loader_path/Frameworks",
        ],
        "MACH_O_TYPE": "staticlib",
        "MACOSX_DEPLOYMENT_TARGET": "27.0",
        "MARKETING_VERSION": "1.4.2",
        "MODULE_VERIFIER_SUPPORTED_LANGUAGES": "objective-c objective-c++",
        "MODULE_VERIFIER_SUPPORTED_LANGUAGE_STANDARDS": "gnu17 gnu++20",
        "PRODUCT_BUNDLE_IDENTIFIER": "com.yourcompany.MatineeKit",
        "PRODUCT_NAME": "$(TARGET_NAME:c99extidentifier)",
        "SDKROOT": "auto",
        "SKIP_INSTALL": "YES",
        "STRING_CATALOG_GENERATE_SYMBOLS": "YES",
        "SUPPORTED_PLATFORMS": "macosx",
        "SWIFT_APPROACHABLE_CONCURRENCY": "YES",
        "SWIFT_EMIT_LOC_STRINGS": "YES",
        "SWIFT_INSTALL_MODULE": "YES",
        "SWIFT_INSTALL_OBJC_HEADER": "NO",
        "SWIFT_UPCOMING_FEATURE_MEMBER_IMPORT_VISIBILITY": "YES",
        "SWIFT_VERSION": "6.0",
        "TARGETED_DEVICE_FAMILY": "1,2,7",
        "VERSIONING_SYSTEM": "apple-generic",
        "VERSION_INFO_PREFIX": "",
        "XROS_DEPLOYMENT_TARGET": "27.2",
      },
    }, {
